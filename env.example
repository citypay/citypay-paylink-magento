CITYPAY_PLUGIN_DIR=.

DOCKER_PLATFORM=linux/amd64
NGROK_ARCH=linux-amd64
MAGENTO_PORT_BIND=127.0.0.1:8081
MAGENTO_HTTP_PORT=8081

MAGENTO_PUBLIC_KEY=
MAGENTO_PRIVATE_KEY=

BASE_URL=http://localhost:8081/

ADMIN_USER=citypay
ADMIN_PASS=Password123!
